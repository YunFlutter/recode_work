rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validDeviceKey(deviceKey) {
      return deviceKey.matches('android_[0-9a-f]{64}');
    }

    function signedIn() {
      return request.auth != null;
    }

    function validDateKey(dateKey) {
      return dateKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    function validTime(value) {
      return value == null || (
        value is map &&
        value.keys().hasOnly(['hour', 'minute']) &&
        value.hour is int &&
        value.hour >= 0 &&
        value.hour <= 23 &&
        value.minute is int &&
        value.minute >= 0 &&
        value.minute <= 59
      );
    }

    function validWorkSession(value) {
      return value is map &&
        value.keys().hasAll(['startTime', 'endTime']) &&
        value.keys().hasOnly(['startTime', 'endTime']) &&
        validTime(value.startTime) &&
        validTime(value.endTime);
    }

    function validWorkSessions(value) {
      return value is list &&
        value.size() <= 10 &&
        (value.size() < 1 || validWorkSession(value[0])) &&
        (value.size() < 2 || validWorkSession(value[1])) &&
        (value.size() < 3 || validWorkSession(value[2])) &&
        (value.size() < 4 || validWorkSession(value[3])) &&
        (value.size() < 5 || validWorkSession(value[4])) &&
        (value.size() < 6 || validWorkSession(value[5])) &&
        (value.size() < 7 || validWorkSession(value[6])) &&
        (value.size() < 8 || validWorkSession(value[7])) &&
        (value.size() < 9 || validWorkSession(value[8])) &&
        (value.size() < 10 || validWorkSession(value[9]));
    }

    function validAttendanceRecord() {
      return request.resource.data.keys().hasOnly([
          'status',
          'startTime',
          'endTime',
          'workSessions',
          'memo',
          'schemaVersion',
          'updatedAt'
        ]) &&
        request.resource.data.status in [
          'present',
          'overtime',
          'rest',
          'halfDay',
          'absent'
        ] &&
        validTime(request.resource.data.startTime) &&
        validTime(request.resource.data.endTime) &&
        validWorkSessions(request.resource.data.workSessions) &&
        request.resource.data.memo is string &&
        request.resource.data.memo.size() <= 2000 &&
        request.resource.data.schemaVersion == 2 &&
        request.resource.data.updatedAt == request.time;
    }

    match /attendance_devices/{deviceKey}/records/{dateKey} {
      // The app signs in anonymously without showing a login screen.
      allow get: if signedIn() &&
        validDeviceKey(deviceKey) &&
        validDateKey(dateKey);
      allow list: if signedIn() && validDeviceKey(deviceKey);
      allow create, update: if signedIn() &&
        validDeviceKey(deviceKey) &&
        validDateKey(dateKey) &&
        validAttendanceRecord();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
